/**
 * Najma district rule v4 — LOD 3 REAL facade geometry for the Unreal / Datasmith film lane.
 *
 * Derived from najma_v2.cga (same object attrs status / bHeight / levels / pctComplete / fclass / fvar,
 * same massing thresholds, same status palette, same GFA / Storeys reports). LOD 0-2 reproduce the v2
 * look exactly; LOD 3 (new, default here) replaces the flat colour bands with geometry:
 *
 *   towers (>= towerMin)   podium (outset podiumOut) with a 4.5 m retail ground floor: glazing recessed
 *                          `recess` behind 0.6 m columns every 6 m; podium upper floors in the class
 *                          grammar; podium roof with a 1.2 m parapet ring. Shaft: 0.6 m corner piers that
 *                          close the strip recesses, per-floor spandrel band projecting `bandProj` (front +
 *                          soffit + sill), vision strip recessed `recess`, full-height mullion bars
 *                          (finW x finProj) every mullionW(v) on glass classes, balconies (slab 1.4 m deep
 *                          + 1.1 m glass balustrade) on every other 3.6 m bay of glass / render towers
 *                          above the podium, 1.2 m parapet (flat band + cap + inner faces, deck sunk
 *                          1.2 m), 2-3 roof plant boxes 3.0-4.0 m high sized by the footprint.
 *   mid-rise (20-60 m)     same shaft grammar on the footprint, no podium, no plant, no balconies unless
 *                          balconyMinH is lowered. Non-glass classes get punched windows 1.5 x 1.6 m
 *                          recessed `recess` (pane + 4 reveals) with a projecting slab band per floor.
 *   low-rise (< 20 m)      LOD 2-class detail, all flat: slab line + punched window row per floor, flat
 *                          roof. ~200 faces per villa.
 *
 * Material SLOTS: every leaf sets material.name so Datasmith / Unreal receives one slot per surface kind:
 *   <class>_vision  <class>_spandrel  <class>_wall  (class = glassblue glassclear glassbronze stone render
 *   concrete brick)  mullion  column  reveal  window_glass  retail_glass  slab_band  balcony_slab  balustrade
 *   parapet  roof  plant  ghost. Non-"existing" status appends _<status> (e.g. render_wall_construction).
 *   Colours are the v2 status palette (nearest-colour classification by the web viewer still holds).
 *
 * Face budget (measured, see data/ce/_datasmith/<slug>_lod3_stats.json): every leaf reports "Faces" and
 * "Faces.<slot>" so the export callback (scripts/ce_report_v2.py) sums polygons per building and per slot.
 * Knobs that trade detail for polygons: balconyMinH (60 -> 999 removes balconies), finProj = 0 keeps the
 * mullion look but drops fins to 1 face, LOD 2 falls back to the flat v2 grammar.
 *
 * Geometry conventions verified in CE 2025.1 (probe 11 Sep 2026): on a facade face `t(0,0,-d) extrude(d)`
 * gives top = cap on the facade plane, bottom = cap at -d, side = the 4 reveals with normals pointing INTO
 * the wall (hence reverseNormals). Positive extrude(p) gives top = outer face, back = upper surface,
 * front = soffit, left/right = ends. Face scopes are x/y in-plane with z = normal.
 */
version "2023.0"

// ---------------------------------------------------------------- object attributes
attr status      = "existing"     // existing | construction | pipeline
attr bHeight     = 12             // m — OSM height or levels x 3.2 at export; 12 = placeholder
attr levels      = ""             // OSM building:levels (string column in the SHP)
attr pctComplete = 100
@Enum("auto", "glassblue", "glassclear", "glassbronze", "stone", "render", "concrete", "brick")
attr fclass      = "auto"         // facade class (scripts/facade_classes.py -> object attr)
attr fvar        = -1             // deterministic variant, feature index % 3 (ce_batch_v2.py)

// ---------------------------------------------------------------- design controls
@Range(min=0, max=3, stepsize=1, restricted=true)
attr LOD           = 3
@Range(min=-1, max=2, stepsize=1, restricted=true)
attr facadeVariant = -1           // -1 = auto (fvar, else footprint-area hash); 0/1/2 pins
@Range(min=1, max=6, stepsize=1, restricted=true)
attr bandEvery     = 1            // storeys per slab band at LOD 1
attr floorH        = 3.4
attr podiumFloorH  = 4.5
attr podiumOut     = 1.0          // podium set-out beyond the footprint, m
attr towerMin      = 60
attr facadeMin     = 20
attr placeholderH  = 12
attr crownPct      = 0.02

// LOD 3 dimensions (m)
attr recess        = 0.30         // window / vision-strip reveal depth (0.25-0.35)
attr bandProj      = 0.15         // spandrel / slab band projection
attr finW          = 0.08         // mullion bar width
attr finProj       = 0.12         // mullion bar projection
attr pierW         = 0.60         // corner pier width (closes the strip recess at each facade end)
attr parapetH      = 1.20
attr parapetT      = 0.30
attr balconyD      = 1.40
attr balconySlabT  = 0.20
attr balustradeH   = 1.10
attr balconyBay    = 3.60
attr balconyMinH   = 60           // glass + render buildings at/above this height get balconies
attr balconyContinuous = 0        // 1 = one balcony slab + glass balustrade across the whole facade on every floor (DAMAC Hills
                                  //     Akoya apartment blocks, matched to photos 14 Sep); 0 = every other bay
attr retailH       = 4.50
attr colW          = 0.60
attr colBay        = 6.00
attr punchBay      = 3.60
attr winW          = 1.50
attr winH          = 1.60
attr slabH         = 0.30
attr lowBay        = 3.40

// LOD 3 low-rise: "villa" = detached villa / townhouse-row grammar (DAMAC Hills lane), "flat" = flat punched rows
// (the Sobha Hartland export of 11 Sep 08:08 was made with the flat grammar — set lowStyle = "flat" to reproduce it)
@Enum("villa", "flat")
attr lowStyle      = "villa"
attr streetAz      = -999         // bearing (deg, CE frame atan2(x, z)) of the street-facing facade normal; pushed per building by
                                  // scripts/ce_lod3_datasmith.py from highways_osm.json (nearest road); -999 = unknown -> no porch/garage
attr villaFloorH   = 3.5
attr villaStoreysDefault = 2      // bHeight 12 is the export placeholder; DAMAC Hills stock is G+1 unless OSM levels say otherwise
attr villaParapet  = 1.0
attr villaRecess   = 0.20
attr villaBay      = 4.0
attr vWinW         = 1.4
attr vWinH         = 1.5
attr rowUnitW      = 6.0          // townhouse unit width along the street face
attr rowMinAspect  = 2.2          // footprint long/short >= this and long >= rowMinLen -> terraced row, not a detached villa
attr rowMinLen     = 24
attr garageW       = 3.0
attr garageH       = 2.4
attr porchW        = 2.4
attr porchD        = 1.5
attr doorH         = 2.4
attr wallSetback   = 0            // > 0 builds a boundary wall this far outside the footprint. OFF: no plot polygons exist in the repo
attr wallH         = 1.8          //   (data/board/plots.json + subs.json are points), so any wall here would be synthetic

// ---------------------------------------------------------------- derived quantities
lvl        = float(levels)
hasLevels  = lvl > 0
bldgH      = case bHeight > 0 && !(bHeight == placeholderH && hasLevels) : bHeight
             case hasLevels : lvl * floorH
             else : placeholderH
isTower    = bldgH >= towerMin
isMid      = bldgH >= facadeMin
podiumN    = case bldgH < 90 : 4  case bldgH < 150 : 5  else : 6
podiumH    = podiumN * podiumFloorH
crownH     = bldgH * crownPct
shaftH     = bldgH - podiumH - crownH
storeysEst = case isTower : podiumN + rint(shaftH / floorH)  else : max(1, rint(bldgH / floorH))
statusOpacity = case status == "construction" : 0.8  else : 1

cls        = case fclass != "auto" && fclass != "" : fclass
             case bldgH > 100 : "glassblue"
             case bldgH > 40  : "concrete"
             else : "render"
isGlass(c)     = c == "glassblue" || c == "glassclear" || c == "glassbronze"
hasBalcony(c)  = bldgH >= balconyMinH && (isGlass(c) || c == "render")

// villa massing: storeys from OSM levels, else from a real height, else the district default (placeholder 12 m is NOT a height)
villaStoreys = case hasLevels : min(3, max(1, rint(lvl)))
               case bHeight > 0 && bHeight != placeholderH : min(3, max(1, rint(bHeight / villaFloorH)))
               else : villaStoreysDefault
villaH       = villaStoreys * villaFloorH + villaParapet
isRowNow     = max(scope.sx, scope.sz) / max(0.1, min(scope.sx, scope.sz)) >= rowMinAspect && max(scope.sx, scope.sz) >= rowMinLen
// street face: compare this facade's outward normal bearing (world, CE frame) with the pushed streetAz
faceAz       = atan2(convert(x, scope, world, pos, 0, 0, 1) - convert(x, scope, world, pos, 0, 0, 0),
                     convert(z, scope, world, pos, 0, 0, 1) - convert(z, scope, world, pos, 0, 0, 0))
azDiff       = abs(((faceAz - streetAz + 540) % 360) - 180)
isStreetFace = streetAz > -900 && azDiff < 35

variantOf(a) = case facadeVariant >= 0 : facadeVariant
               case fvar >= 0 : fvar
               else : floor(a) % 3
bandRatio(v) = case v == 0 : 0.30  case v == 1 : 0.36  else : 0.42
mullionW(v)  = case v == 0 : 1.6   case v == 1 : 1.8   else : 2.1

// ---------------------------------------------------------------- palette (in-family only, from v2)
col_glassblue(st)   = case st == "construction" : "#3EA292" case st == "pipeline" : "#DBB265" else : "#485665"
col_glassclear(st)  = case st == "construction" : "#5F948C" case st == "pipeline" : "#C5AF86" else : "#555C64"
col_glassbronze(st) = case st == "construction" : "#5D857E" case st == "pipeline" : "#B7A788" else : "#494F55"
col_stone(st)       = case st == "construction" : "#688C87" case st == "pipeline" : "#BCAC90" else : "#515656"
col_render(st)      = case st == "construction" : "#67928B" case st == "pipeline" : "#C1AF8E" else : "#545A61"
col_concrete(st)    = case st == "construction" : "#67837F" case st == "pipeline" : "#B3A792" else : "#4F5257"
col_brick(st)       = case st == "construction" : "#349788" case st == "pipeline" : "#D5AB5D" else : "#3B4858"
col_slab(st)        = case st == "construction" : "#35756B" case st == "pipeline" : "#A78C5A" else : "#303943"
col_window(st)      = case st == "construction" : "#2F8175" case st == "pipeline" : "#B99656" else : "#313C49"
col_crown(st)       = case st == "construction" : "#427A71" case st == "pipeline" : "#AE966B" else : "#363E47"
col_roof(st)        = case st == "construction" : "#37796F" case st == "pipeline" : "#AD915D" else : "#323B46"
col_base(st)        = case st == "construction" : "#3E8A7E" case st == "pipeline" : "#C5A56A" else : "#39434F"

wallCol(c) = case c == "glassblue"   : col_glassblue(status)
             case c == "glassclear"  : col_glassclear(status)
             case c == "glassbronze" : col_glassbronze(status)
             case c == "stone"       : col_stone(status)
             case c == "concrete"    : col_concrete(status)
             case c == "brick"       : col_brick(status)
             else                    : col_render(status)

slotName(nm) = case status == "existing" : nm  else : nm + "_" + status

// ---------------------------------------------------------------- material leaves (every surface ends here)
Mat(nm, col) -->
    color(col)
    set(material.name, slotName(nm))
    report("Faces", geometry.nFaces)
    report("Faces." + nm, geometry.nFaces)
    Mat.

Glass(nm, col) -->
    color(col)
    set(material.name, slotName(nm))
    set(material.metallic, 0)
    set(material.roughness, 0.08)
    report("Faces", geometry.nFaces)
    report("Faces." + nm, geometry.nFaces)
    Glass.

GlassT(nm, col, op) -->
    color(col)
    set(material.name, slotName(nm))
    set(material.metallic, 0)
    set(material.roughness, 0.05)
    set(material.opacity, op)
    report("Faces", geometry.nFaces)
    report("Faces." + nm, geometry.nFaces)
    GlassT.

Spandrel --> Mat("spandrel", col_slab(status))
Mullion  --> Mat("mullion", col_slab(status))
Window   --> Glass("window_glass", col_window(status))
Wall(c)  --> Mat(c + "_wall", wallCol(c))
Roof     --> Mat("roof", col_roof(status))

// ---------------------------------------------------------------- start
@StartRule
Lot -->
    cleanupGeometry(all, 0.3)
    report("Footprint_m2", geometry.area)
    report("Height_m", bldgH)
    report("Storeys_est", storeysEst)
    report("Class." + cls, 1)
    report("Variant", variantOf(geometry.area))
    report("LOD", LOD)
    set(material.opacity, statusOpacity)
    Building(variantOf(geometry.area), cls)

Building(v, c) -->
    case status == "pipeline" : Ghost
    case LOD == 0             : Plain
    case LOD >= 3 && isTower  : Tower3(v, c)
    case LOD >= 3 && isMid    : Mid3(v, c)
    case LOD >= 3 && lowStyle == "villa" : Villa3(v, c)
    case LOD >= 3             : Low3(v, c)
    case isTower              : Tower(v, c)
    else                      : Low(v, c)

// pipeline ghost — design unknown, so no facade family; exact status colour, translucent
Ghost -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    color(col_base("pipeline"))
    set(material.name, "ghost")
    set(material.opacity, 0.4)
    report("Faces", geometry.nFaces)
    Ghost.

// LOD 0 — plain extrusion, exact status colour
Plain -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    PlainPaint
PlainPaint -->
    case status == "construction" :
        color(col_base("construction"))
        split(y){ bldgH * pctComplete / 100 : PlainPaint. | ~1 : set(material.opacity, 0.25) PlainPaint. }
    else :
        color(col_base(status))
        PlainPaint.

// ================================================================ LOD 3 — towers
Tower3(v, c) -->
    [ offset(podiumOut, inside) Podium3(v, c) ]
    t(0, podiumH, 0)
    extrude(bldgH - podiumH)
    [ StoreyReports(floorH) ]
    comp(f){ side : ShaftFacade3(v, c) | top : RoofSunk(v, true) }

Podium3(v, c) -->
    extrude(podiumH)
    [ StoreyReports(podiumFloorH) ]
    comp(f){ side : PodiumFacade3(v, c) | top : RoofRaised }

PodiumFacade3(v, c) -->
    case scope.sx < 2.5 : Wall(c)
    else : split(y){ retailH : RetailFloor(c) | ~1 : PodiumUpper(v, c) }

PodiumUpper(v, c) -->
    split(x){ pierW : Pier(c) | ~1 : PodiumField(v, c) | pierW : Pier(c) }

PodiumField(v, c) -->
    [ FinsIf(v, c) ]
    split(y){ ~podiumFloorH : Floor3(v, c, false) }*

// ground-floor retail: glazing recessed behind columns
RetailFloor(c) -->
    case scope.sx < colBay : RetailGlass
    else : split(x){ colW : Column | ~1 : split(x){ ~colBay : RetailBay }* }
RetailBay   --> split(x){ ~1 : RetailGlass | colW : Column }
RetailGlass --> t(0, 0, -recess) Glass("retail_glass", col_window(status))
Column -->
    t(0, 0, -recess) extrude(recess + bandProj)
    comp(f){ top : Mat("column", col_slab(status)) | left : Mat("column", col_slab(status)) | right : Mat("column", col_slab(status)) }

// shaft (also the mid-rise facade)
ShaftFacade3(v, c) -->
    case scope.sx < 2.5 : Wall(c)
    else : split(x){ pierW : Pier(c) | ~1 : ShaftField(v, c) | pierW : Pier(c) }

ShaftField(v, c) -->
    [ FinsIf(v, c) ]
    split(y){ ~1 : split(y){ ~floorH : Floor3(v, c, hasBalcony(c)) }* | parapetH : ParapetBand }

ParapetBand --> Mat("parapet", col_crown(status))

// corner pier: spans from the recess plane to the band projection, so strip recesses end on a jamb
Pier(c) -->
    t(0, 0, -recess) extrude(recess + bandProj)
    comp(f){ top : Mat(c + "_wall", wallCol(c)) | left : Mat(c + "_wall", wallCol(c)) | right : Mat(c + "_wall", wallCol(c)) }

// full-height mullion bars at every bay boundary (glass classes only)
FinsIf(v, c) --> case isGlass(c) : Fins(v)  else : NIL
Fins(v) -->
    case scope.sx < 2 * mullionW(v) : NIL
    else : split(x){ ~mullionW(v) : NIL | finW : FinBox }*
FinBox -->
    extrude(finProj)
    comp(f){ top : Mat("mullion", col_slab(status)) | left : Mat("mullion", col_slab(status)) | right : Mat("mullion", col_slab(status)) }

// one floor: optional balcony overlay + the class grammar
Floor3(v, c, balc) -->
    [ BalconyRowIf(v, balc) ]
    FloorBody(v, c)

FloorBody(v, c) -->
    case isGlass(c) : split(y){ bandRatio(v) * floorH : SpandrelBox(c) | ~1 : VisionStrip(c) }
    else            : split(y){ slabH : SlabBox | ~0.9 : Wall(c) | winH : WindowRow(c) | ~0.6 : Wall(c) }

SpandrelBox(c) -->
    t(0, 0, -recess) extrude(recess + bandProj)
    comp(f){ top : Mat(c + "_spandrel", col_slab(status)) | front : Mat(c + "_spandrel", col_slab(status)) | back : Mat(c + "_spandrel", col_slab(status)) }
VisionStrip(c) --> t(0, 0, -recess) Glass(c + "_vision", wallCol(c))

SlabBox -->
    t(0, 0, -recess) extrude(recess + bandProj)
    comp(f){ top : Mat("slab_band", col_slab(status)) | front : Mat("slab_band", col_slab(status)) | back : Mat("slab_band", col_slab(status)) }

WindowRow(c) --> split(x){ ~punchBay : PunchBay(c) }*
PunchBay(c) -->
    case scope.sx < winW + 0.4 : Wall(c)
    else : split(x){ ~1 : Wall(c) | winW : RecessWindow | ~1 : Wall(c) }
RecessWindow -->
    [ t(0, 0, -recess) Glass("window_glass", col_window(status)) ]
    t(0, 0, -recess) extrude(recess)
    comp(f){ side : reverseNormals Mat("reveal", col_slab(status)) }

// balconies: every other bay, slab + glass balustrade
BalconyRowIf(v, balc) --> case balc : BalconyRow(v)  else : NIL
BalconyRow(v) -->
    case balconyContinuous > 0 && scope.sx >= 2.0 : BalconyBody
    case scope.sx < 1.5 * balconyBay : NIL
    case v == 1 : split(x){ ~balconyBay : BalconyBody | ~balconyBay : NIL }*
    else        : split(x){ ~balconyBay : NIL | ~balconyBay : BalconyBody }*
BalconyBody -->
    split(x){ 0.25 : NIL | ~1 : split(y){ balconySlabT : BalconySlab | balustradeH : Balustrade | ~1 : NIL } | 0.25 : NIL }
BalconySlab -->
    extrude(balconyD)
    comp(f){ top : Mat("balcony_slab", col_crown(status)) | back : Mat("balcony_slab", col_crown(status)) | front : Mat("balcony_slab", col_crown(status))
           | left : Mat("balcony_slab", col_crown(status)) | right : Mat("balcony_slab", col_crown(status)) }
Balustrade -->
    extrude(balconyD)
    comp(f){ top : GlassT("balustrade", col_window(status), 0.45) | left : GlassT("balustrade", col_window(status), 0.45) | right : GlassT("balustrade", col_window(status), 0.45) }

// roofs
// sunk: deck 1.2 m below the roof line, parapet = facade band + cap + inner faces; plant boxes on towers
RoofSunk(v, plant) -->
    [ offset(-parapetT, border) Mat("parapet", col_crown(status)) ]
    offset(-parapetT, inside)
    extrude(-parapetH)
    comp(f){ side : reverseNormals Mat("parapet", col_crown(status)) | top : reverseNormals RoofDeck(v, plant) }

// raised: parapet ring rises above the deck (podium roof — the shaft sits on the deck level)
RoofRaised -->
    [ offset(-parapetT, border) extrude(parapetH) comp(f){ side : Mat("parapet", col_crown(status)) | top : Mat("parapet", col_crown(status)) } ]
    offset(-parapetT, inside) Mat("roof", col_roof(status))

RoofDeck(v, plant) -->
    case plant : [ Mat("roof", col_roof(status)) ] PlantLayout(v)
    else       : Mat("roof", col_roof(status))

PlantLayout(v) -->
    case v == 1 :
        split(x){ ~0.15 : NIL | ~0.30 : split(y){ ~0.20 : NIL | ~0.40 : PlantBox(3.6) | ~0.40 : NIL }
                | ~0.10 : NIL | ~0.25 : split(y){ ~0.45 : NIL | ~0.30 : PlantBox(3.0) | ~0.25 : NIL } | ~0.20 : NIL }
    else :
        split(x){ ~0.12 : NIL | ~0.30 : split(y){ ~0.18 : NIL | ~0.36 : PlantBox(3.8) | ~0.46 : NIL }
                | ~0.08 : NIL | ~0.22 : split(y){ ~0.50 : NIL | ~0.28 : PlantBox(3.2) | ~0.22 : NIL }
                | ~0.06 : NIL | ~0.14 : split(y){ ~0.15 : NIL | ~0.25 : PlantBox(4.0) | ~0.60 : NIL } | ~0.08 : NIL }
PlantBox(h) -->
    extrude(h)
    comp(f){ top : Mat("plant", col_crown(status)) | side : Mat("plant", col_crown(status)) }

// ================================================================ LOD 3 — mid-rise (20-60 m)
Mid3(v, c) -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    comp(f){ side : ShaftFacade3(v, c) | top : RoofSunk(v, false) }

// ================================================================ LOD 3 — villas / townhouse rows (< 20 m), lowStyle = "villa"
// G+1 (default) or G+2 volume, flat Dubai roof with a 1.0 m parapet (deck sunk) and a 4 x 3 m roof-access box, windows
// recessed 0.2 m on a 4.0 m bay rhythm, and on the STREET face (streetAz) a covered entrance (canopy on two columns) plus a
// garage shutter; terraced rows repeat a door + shutter per 6 m unit. Optional synthetic boundary wall (wallSetback > 0).
Villa3(v, c) -->
    report("Villa_storeys", villaStoreys)
    report("Villa_row", isRowNow)
    [ WallIf ]
    VillaBody(v, c, isRowNow)

WallIf -->
    case wallSetback > 0 : offset(wallSetback, inside) BoundaryWall
    else : NIL
BoundaryWall -->
    offset(-0.2, border) extrude(wallH)
    comp(f){ side : Mat("boundary_wall", col_stone(status)) | top : Mat("boundary_wall", col_stone(status)) }

VillaBody(v, c, row) -->
    extrude(villaH)
    [ StoreyReports(villaFloorH) ]
    comp(f){ side : VillaFacade(v, c, row) | top : RoofVilla(v) }

VillaFacade(v, c, row) -->
    case scope.sx < 2.0          : Wall(c)
    case isStreetFace && row     : RowStreet(v, c)
    case isStreetFace            : VillaStreet(v, c)
    else                         : VillaSide(c)

VillaSide(c) -->
    split(y){ ~1 : split(y){ ~villaFloorH : VillaFloor(c) }* | villaParapet : ParapetBand }

VillaFloor(c) -->
    split(y){ 0.25 : Mat("slab_band", col_slab(status)) | ~0.9 : Wall(c) | vWinH : VWindowRow(c) | ~0.85 : Wall(c) }
VWindowRow(c) --> split(x){ ~villaBay : VBay(c) }*
VBay(c) -->
    case scope.sx < vWinW + 0.5 : Wall(c)
    else : split(x){ ~1 : Wall(c) | vWinW : VWindow | ~1 : Wall(c) }
VWindow -->
    [ t(0, 0, -villaRecess) Glass("window_glass", col_window(status)) ]
    t(0, 0, -villaRecess) extrude(villaRecess)
    comp(f){ side : reverseNormals Mat("reveal", col_slab(status)) }

// detached villa street face: ground floor = windows | porch | garage (mirrored by variant), upper floors = windows
VillaStreet(v, c) -->
    split(y){ villaFloorH : VillaGround(v, c) | ~1 : split(y){ ~villaFloorH : VillaFloor(c) }* | villaParapet : ParapetBand }
VillaGround(v, c) -->
    case scope.sx < garageW + porchW + 3.0 : VillaFloor(c)
    case v == 1 : split(x){ ~1 : VillaFloor(c) | porchW : EntranceBay(c) | 0.6 : Wall(c) | garageW : GarageBay(c) | 1.0 : Wall(c) }
    else        : split(x){ 1.0 : Wall(c) | garageW : GarageBay(c) | 0.6 : Wall(c) | porchW : EntranceBay(c) | ~1 : VillaFloor(c) }

GarageBay(c) -->
    split(y){ garageH : GarageDoor | ~1 : Wall(c) }
GarageDoor -->
    [ t(0, 0, -0.15) Mat("garage_door", col_crown(status)) ]
    t(0, 0, -0.15) extrude(0.15)
    comp(f){ side : reverseNormals Mat("reveal", col_slab(status)) }

EntranceBay(c) -->
    split(y){ doorH : split(x){ 0.25 : PorchColumn | ~1 : split(x){ 0.35 : Wall(c) | ~1 : EntryDoor | 0.35 : Wall(c) } | 0.25 : PorchColumn }
            | 0.25 : Canopy(porchD) | ~1 : Wall(c) }
PorchColumn -->
    t(0, 0, porchD - 0.25) extrude(0.25)
    comp(f){ top : Mat("column", col_slab(status)) | bottom : Mat("column", col_slab(status)) | left : Mat("column", col_slab(status)) | right : Mat("column", col_slab(status)) }
Canopy(d) -->
    extrude(d)
    comp(f){ top : Mat("slab_band", col_slab(status)) | back : Mat("slab_band", col_slab(status)) | front : Mat("slab_band", col_slab(status))
           | left : Mat("slab_band", col_slab(status)) | right : Mat("slab_band", col_slab(status)) }
EntryDoor -->
    [ t(0, 0, -villaRecess) Mat("entry_door", col_crown(status)) ]
    t(0, 0, -villaRecess) extrude(villaRecess)
    comp(f){ side : reverseNormals Mat("reveal", col_slab(status)) }

// terraced row street face: one door + one shutter per rowUnitW unit, windows above
RowStreet(v, c) -->
    split(y){ villaFloorH : split(x){ ~rowUnitW : RowUnitGround(c) }* | ~1 : split(y){ ~villaFloorH : VillaFloor(c) }* | villaParapet : ParapetBand }
RowUnitGround(c) -->
    case scope.sx < 4.5 : VillaFloor(c)
    else : split(x){ 0.4 : Wall(c) | 2.8 : GarageBay(c) | 0.3 : Wall(c) | ~1 : RowDoorBay(c) | 0.4 : Wall(c) }
RowDoorBay(c) -->
    split(y){ doorH : split(x){ ~0.2 : Wall(c) | 1.0 : EntryDoor | ~0.2 : Wall(c) } | 0.2 : Canopy(1.0) | ~1 : Wall(c) }

// flat roof: parapet cap + inner faces, deck sunk villaParapet, one 4 x 3 m roof-access box (stair bulkhead) 2.4 m high
RoofVilla(v) -->
    [ offset(-0.25, border) Mat("parapet", col_crown(status)) ]
    offset(-0.25, inside)
    extrude(-villaParapet)
    comp(f){ side : reverseNormals Mat("parapet", col_crown(status)) | top : reverseNormals VillaDeck(v) }
VillaDeck(v) -->
    [ Mat("roof", col_roof(status)) ]
    RoofAccessLayout(v)
RoofAccessLayout(v) -->
    case v == 1 : split(x){ ~0.3 : NIL | 4.0 : split(y){ ~0.2 : NIL | 3.0 : RoofAccess | ~1 : NIL } | ~1 : NIL }
    else        : split(x){ ~1 : NIL | 4.0 : split(y){ ~1 : NIL | 3.0 : RoofAccess | ~0.2 : NIL } | ~0.3 : NIL }
RoofAccess -->
    extrude(2.4)
    comp(f){ top : Mat("roof_access", col_crown(status)) | side : Mat("roof_access", col_crown(status)) }

// ================================================================ LOD 3 — low-rise (< 20 m), lowStyle = "flat": flat detail
Low3(v, c) -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    comp(f){ side : LowFacade3(v, c) | top : Mat("roof", col_roof(status)) }

LowFacade3(v, c) -->
    case scope.sx < 2.0 : Wall(c)
    else : split(y){ ~1 : split(y){ ~floorH : LowFloor(c) }* | 0.5 : Mat("parapet", col_crown(status)) }
LowFloor(c) -->
    split(y){ slabH : Mat("slab_band", col_slab(status)) | ~0.9 : Wall(c) | winH : LowWindowRow(c) | ~0.6 : Wall(c) }
LowWindowRow(c) --> split(x){ ~lowBay : LowBay(c) }*
LowBay(c) -->
    case scope.sx < winW + 0.4 : Wall(c)
    else : split(x){ ~1 : Wall(c) | winW : Glass("window_glass", col_window(status)) | ~1 : Wall(c) }

// ================================================================ LOD 1-2 (v2 grammar, unchanged)
Tower(v, c) -->
    [ offset(podiumOut, inside) Podium(v, c) ]
    t(0, podiumH, 0)
    extrude(bldgH - podiumH)
    split(y){ ~1 : Shaft(v, c) | crownH : Crown }

Podium(v, c) -->
    extrude(podiumH)
    [ StoreyReports(podiumFloorH) ]
    comp(f){ side : PodiumFacade(v, c) | top : Roof }

PodiumFacade(v, c) -->
    case LOD >= 1 : split(y){ ~podiumFloorH : FloorBand(v, c) }*
    else          : Wall(c)

Shaft(v, c) -->
    [ StoreyReports(floorH) ]
    comp(f){ side : ShaftFacade(v, c) }

ShaftFacade(v, c) -->
    case LOD >= 1 : split(y){ ~(floorH * bandEvery) : FloorBand(v, c) }*
    else          : Wall(c)

Crown -->
    comp(f){ side : CrownBand | top : Roof }
CrownBand --> Mat("parapet", col_crown(status))

Low(v, c) -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    comp(f){ side : LowFacade(v, c) | top : Roof }

LowFacade(v, c) -->
    case LOD >= 1 && isMid : split(y){ ~(floorH * bandEvery) : FloorBand(v, c) }*
    case LOD >= 1          : split(y){ ~1 : Wall(c) | 0.35 : Spandrel }
    else                   : Wall(c)

FloorBand(v, c) -->
    split(y){ bandRatio(v) * floorH : Spandrel | ~1 : Vision(v, c) }

Vision(v, c) -->
    case LOD >= 2 && isGlass(c) : split(x){ ~mullionW(v) : Panel(c) }*
    case LOD >= 2               : split(x){ ~3.4 : PunchedBay(c) }*
    else                        : Wall(c)

Panel(c)       --> split(x){ 0.07 : Mullion | ~1 : Wall(c) | 0.07 : Mullion }
PunchedBay(c)  --> split(x){ ~1 : Wall(c) | 1.2 : WindowStrip(c) | ~1 : Wall(c) }
WindowStrip(c) --> split(y){ ~0.7 : Wall(c) | 1.6 : Window | ~0.3 : Wall(c) }

// ---------------------------------------------------------------- reports
// runs on a scope copy of every extruded part: one GFA value + one Storeys tick per slab
StoreyReports(fh) -->
    split(y){ ~fh : Storey }*
Storey     --> comp(f){ bottom : StoreySlab }
StoreySlab --> report("GFA", geometry.area) report("Storeys", 1) NIL
