/**
 * Najma district rule v2 — truer massing + a one-city facade family.
 *
 * Drop-in for najma.cga: same object attrs (status / bHeight / pctComplete) plus
 * levels, fclass, fvar. Same three status colours — the web viewer classifies every
 * mesh by nearest colour against exactly #39434F existing / #3E8A7E construction /
 * #C5A56A pipeline, so EVERY colour below is a lightness/saturation variation inside
 * its status family (verified nearest-colour in sRGB and linear space, margin <= 0.8).
 * No textures: geometry + flat material colour only.
 *
 * Massing
 *   height   = bHeight; if bHeight is the export placeholder (12) and OSM levels are
 *              known, levels x floorH wins; if bHeight is missing, levels x floorH.
 *   towers   >= towerMin (60 m): podium (4/5/6 storeys at 4.5 m, slight outset)
 *              + shaft (3.4 m floor bands) + crown (top 2 %).
 *   mid      20-60 m: shaft grammar on the footprint, flat roof.
 *   low      < 20 m: plain walls, one slab band at the parapet, flat roof.
 *   pipeline ghosts stay a plain translucent extrusion at every LOD (design unknown).
 *
 * Facade family (LOD 2 adds the fine grain, LOD 1 keeps the bands)
 *   3 deterministic variants (fvar = feature index % 3, pin with facadeVariant):
 *     spandrel ratio 0.30 / 0.36 / 0.42 of the floor, mullion spacing 1.6 / 1.8 / 2.1 m.
 *   material class (fclass, from scripts/facade_classes.py: OSM building:material /
 *   building:colour / Overture facade_* / height default) drives panel proportion
 *   and the wall colour: glass classes = large panels + mullions; stone / render /
 *   concrete / brick = punched windows 1.2 x 1.6 m per 3.4 m bay.
 *
 * Reports (per building, summed by the export callback scripts/ce_report_v2.py):
 *   GFA (one value per floor slab, m2), Storeys (1 per slab), Footprint_m2, Height_m,
 *   Storeys_est, Class.<fclass>, Variant.
 *
 * LOD  0 = plain extrusion (far districts)   1 = massing family + floor bands (viewer)
 *      2 = full facade grammar (hero / render lane). bandEvery = storeys per band at
 *      LOD 1 (size budget knob; 1 = every floor).
 *
 * Export note: CityEngine's glTF encoder writes one mesh per LEAF, so a banded tower is
 * hundreds of meshes and the JSON overhead swamps the geometry. scripts/ce_batch_v2.py
 * exports AS_GENERATED and then runs scripts/glb_merge_per_building.py, which folds the
 * leaves back into one mesh per building ("b<i>_<class>", one primitive per material).
 */
version "2023.0"

// ---------------------------------------------------------------- object attributes
attr status      = "existing"     // existing | construction | pipeline
attr bHeight     = 12             // m — OSM height or levels x 3.2 at export; 12 = placeholder
attr levels      = ""             // OSM building:levels (string column in the SHP)
attr pctComplete = 100
@Enum("auto", "glassblue", "glassclear", "glassbronze", "stone", "render", "concrete", "brick")
attr fclass      = "auto"         // facade class (scripts/facade_classes.py -> object attr)
attr fvar        = -1             // deterministic variant, feature index % 3 (ce_batch_v2.py)

// ---------------------------------------------------------------- design controls
@Range(min=0, max=2, stepsize=1, restricted=true)
attr LOD           = 1
@Range(min=-1, max=2, stepsize=1, restricted=true)
attr facadeVariant = -1           // -1 = auto (fvar, else footprint-area hash); 0/1/2 pins
@Range(min=1, max=6, stepsize=1, restricted=true)
attr bandEvery     = 1            // storeys per slab band at LOD 1
attr floorH        = 3.4
attr podiumFloorH  = 4.5
attr podiumOut     = 1.0          // podium outset beyond the footprint, m
attr towerMin      = 60
attr facadeMin     = 20
attr placeholderH  = 12
attr crownPct      = 0.02

// ---------------------------------------------------------------- derived quantities
lvl        = float(levels)
hasLevels  = lvl > 0
bldgH      = case bHeight > 0 && !(bHeight == placeholderH && hasLevels) : bHeight
             case hasLevels : lvl * floorH
             else : placeholderH
isTower    = bldgH >= towerMin
isMid      = bldgH >= facadeMin
podiumN    = case bldgH < 90 : 4  case bldgH < 150 : 5  else : 6
podiumH    = podiumN * podiumFloorH
crownH     = bldgH * crownPct
shaftH     = bldgH - podiumH - crownH
storeysEst = case isTower : podiumN + rint(shaftH / floorH)  else : max(1, rint(bldgH / floorH))
statusOpacity = case status == "construction" : 0.8  else : 1

cls        = case fclass != "auto" && fclass != "" : fclass
             case bldgH > 100 : "glassblue"
             case bldgH > 40  : "concrete"
             else : "render"
isGlass(c) = c == "glassblue" || c == "glassclear" || c == "glassbronze"

variantOf(a) = case facadeVariant >= 0 : facadeVariant
               case fvar >= 0 : fvar
               else : floor(a) % 3
bandRatio(v) = case v == 0 : 0.30  case v == 1 : 0.36  else : 0.42
mullionW(v)  = case v == 0 : 1.6   case v == 1 : 1.8   else : 2.1

// ---------------------------------------------------------------- palette (in-family only)
// Generated + verified by the palette check in ce_batch_v2.py --palette: each colour's nearest
// status colour is its own family in sRGB AND linear RGB, with distance ratio <= 0.8 to the
// runner-up. Never add a hue here.
col_glassblue(st)   = case st == "construction" : "#3EA292" case st == "pipeline" : "#DBB265" else : "#485665"
col_glassclear(st)  = case st == "construction" : "#5F948C" case st == "pipeline" : "#C5AF86" else : "#555C64"
col_glassbronze(st) = case st == "construction" : "#5D857E" case st == "pipeline" : "#B7A788" else : "#494F55"
col_stone(st)       = case st == "construction" : "#688C87" case st == "pipeline" : "#BCAC90" else : "#515656"
col_render(st)      = case st == "construction" : "#67928B" case st == "pipeline" : "#C1AF8E" else : "#545A61"
col_concrete(st)    = case st == "construction" : "#67837F" case st == "pipeline" : "#B3A792" else : "#4F5257"
col_brick(st)       = case st == "construction" : "#349788" case st == "pipeline" : "#D5AB5D" else : "#3B4858"
col_slab(st)        = case st == "construction" : "#35756B" case st == "pipeline" : "#A78C5A" else : "#303943"
col_window(st)      = case st == "construction" : "#2F8175" case st == "pipeline" : "#B99656" else : "#313C49"
col_crown(st)       = case st == "construction" : "#427A71" case st == "pipeline" : "#AE966B" else : "#363E47"
col_roof(st)        = case st == "construction" : "#37796F" case st == "pipeline" : "#AD915D" else : "#323B46"
col_base(st)        = case st == "construction" : "#3E8A7E" case st == "pipeline" : "#C5A56A" else : "#39434F"

wallCol(c) = case c == "glassblue"   : col_glassblue(status)
             case c == "glassclear"  : col_glassclear(status)
             case c == "glassbronze" : col_glassbronze(status)
             case c == "stone"       : col_stone(status)
             case c == "concrete"    : col_concrete(status)
             case c == "brick"       : col_brick(status)
             else                    : col_render(status)

// ---------------------------------------------------------------- start
@StartRule
Lot -->
    cleanupGeometry(all, 0.3)
    report("Footprint_m2", geometry.area)
    report("Height_m", bldgH)
    report("Storeys_est", storeysEst)
    report("Class." + cls, 1)
    report("Variant", variantOf(geometry.area))
    set(material.opacity, statusOpacity)
    Building(variantOf(geometry.area), cls)

Building(v, c) -->
    case status == "pipeline" : Ghost
    case LOD == 0             : Plain
    case isTower              : Tower(v, c)
    else                      : Low(v, c)

// pipeline ghost — design unknown, so no facade family; exact status colour, translucent
Ghost -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    color(col_base("pipeline"))
    set(material.opacity, 0.4)
    Ghost.

// LOD 0 — the v1 look: plain extrusion, exact status colour
Plain -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    PlainPaint
PlainPaint -->
    case status == "construction" :
        color(col_base("construction"))
        split(y){ bldgH * pctComplete / 100 : PlainPaint. | ~1 : set(material.opacity, 0.25) PlainPaint. }
    else :
        color(col_base(status))
        PlainPaint.

// ---------------------------------------------------------------- tower: podium + shaft + crown
Tower(v, c) -->
    [ offset(podiumOut, inside) Podium(v, c) ]
    t(0, podiumH, 0)
    extrude(bldgH - podiumH)
    split(y){ ~1 : Shaft(v, c) | crownH : Crown }

Podium(v, c) -->
    extrude(podiumH)
    [ StoreyReports(podiumFloorH) ]
    comp(f){ side : PodiumFacade(v, c) | top : Roof }

PodiumFacade(v, c) -->
    case LOD >= 1 : split(y){ ~podiumFloorH : FloorBand(v, c) }*
    else          : Wall(c)

Shaft(v, c) -->
    [ StoreyReports(floorH) ]
    comp(f){ side : ShaftFacade(v, c) }

ShaftFacade(v, c) -->
    case LOD >= 1 : split(y){ ~(floorH * bandEvery) : FloorBand(v, c) }*
    else          : Wall(c)

Crown -->
    comp(f){ side : CrownBand | top : Roof }
CrownBand --> color(col_crown(status)) CrownBand.

// ---------------------------------------------------------------- low / mid buildings
Low(v, c) -->
    extrude(bldgH)
    [ StoreyReports(floorH) ]
    comp(f){ side : LowFacade(v, c) | top : Roof }

LowFacade(v, c) -->
    case LOD >= 1 && isMid : split(y){ ~(floorH * bandEvery) : FloorBand(v, c) }*
    case LOD >= 1          : split(y){ ~1 : Wall(c) | 0.35 : Spandrel }
    else                   : Wall(c)

// ---------------------------------------------------------------- facade family
// one floor band = spandrel (slab colour, variant ratio of a floor) + vision zone
FloorBand(v, c) -->
    split(y){ bandRatio(v) * floorH : Spandrel | ~1 : Vision(v, c) }

Vision(v, c) -->
    case LOD >= 2 && isGlass(c) : split(x){ ~mullionW(v) : Panel(c) }*
    case LOD >= 2               : split(x){ ~3.4 : PunchedBay(c) }*
    else                        : Wall(c)

Panel(c)      --> split(x){ 0.07 : Mullion | ~1 : Wall(c) | 0.07 : Mullion }
PunchedBay(c) --> split(x){ ~1 : Wall(c) | 1.2 : WindowStrip(c) | ~1 : Wall(c) }
WindowStrip(c) --> split(y){ ~0.7 : Wall(c) | 1.6 : Window | ~0.3 : Wall(c) }

Spandrel --> color(col_slab(status))   Spandrel.
Mullion  --> color(col_slab(status))   Mullion.
Window   --> color(col_window(status)) Window.
Wall(c)  --> color(wallCol(c))         Wall.
Roof     --> color(col_roof(status))   Roof.

// ---------------------------------------------------------------- reports
// runs on a scope copy of every extruded part: one GFA value + one Storeys tick per slab
StoreyReports(fh) -->
    split(y){ ~fh : Storey }*
Storey     --> comp(f){ bottom : StoreySlab }
StoreySlab --> report("GFA", geometry.area) report("Storeys", 1) NIL
